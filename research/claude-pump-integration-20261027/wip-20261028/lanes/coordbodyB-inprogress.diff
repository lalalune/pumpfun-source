+fn get_fee_basis_points(fee_config: &FeeConfig, fee_config_len: usize, quote_mint: &Pubkey, market_cap: u128) -> Result<(u64, u64)> {
+    // the fee config account must hold the tiered layout
+    require!(fee_config_len >= 2512, crate::PumpError::FeeConfigTooShort);
+    let fee_tiers: &[FeeTier] = if *quote_mint != Pubkey::default() && *quote_mint != WSOL_QUOTE && *quote_mint != QUOTE_2 {
+        if USDC == *quote_mint {
+            if fee_config_len > 4072 { &fee_config.stable_fee_tiers } else { &[] }
+        } else {
+            let exotic = &fee_config.exotic_flat_fees;
+            let fees = if fee_config_len > 4096 && (exotic.lp_fee_bps != 0 || exotic.protocol_fee_bps != 0 || exotic.creator_fee_bps != 0) { exotic } else { &fee_config.flat_fees };
+            return Ok((fees.protocol_fee_bps, fees.creator_fee_bps));
+        }
+    } else { &fee_config.fee_tiers };
+    calculate_fee_tier(fee_tiers, market_cap)
+}
+
+pub fn get_fees(global: &crate::Global, bonding_curve: &BondingCurve, fee_config: &FeeConfig, fee_config_len: usize, market_cap: u128, amount: u64) -> Result<(u64, u64, u64, u64)> {
+    let (protocol_fee_bps, mut creator_fee_bps) = get_fee_basis_points(fee_config, fee_config_len, &bonding_curve.quote_mint, market_cap)?;
+    if global.creator_fee_configurable && bonding_curve.creator_fee_bps != 0 {
+        creator_fee_bps = bonding_curve.creator_fee_bps;
+    }
+    let protocol_fee = fee(amount, protocol_fee_bps)?;
+    let creator_fee = if bonding_curve.creator == Pubkey::default() { 0 } else { fee(amount, creator_fee_bps)? };
+    Ok((protocol_fee, creator_fee, protocol_fee_bps, creator_fee_bps))
+}
