  "declarations": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-viewer-following": {
      "scope": "graph.read",
      "params": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Subject: cc user-id UUID or wallet"
          }
        },
        "required": [
          "userId"
        ]
      },
      "query": {
        "$ref": "#/$defs/972407.local:p"
      },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/972407.local:z"
        },
        "description": "Plain-list rows in the requested order. 503 when the follow read is unavailable"
      }
    },
    "$defs": {
      "972407.local:p": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "x-zod-optional": true,
            "description": "Page size, default 20. Out-of-range values are rejected with 400, not clamped."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-zod-optional": true,
            "description": "0-indexed offset into the sorted list, default 0"
          },
          "sort": {
            "enum": [
              "followers",
              "recent"
            ],
            "x-zod-optional": true,
            "description": "Row order: `followers` (default) is most-followed first, `recent` is newest follow edge first."
          }
        },
        "required": []
      },
      "972407.local:z": {
        "type": "object",
        "properties": {
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile_image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolved_avatar_decoration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The border to draw on this avatar as a decoration key (`legendary`, `epic`, `achievement:<id>`), never a url — the owner's pick while still earned, else the rarest tier ring the owner's achievements earn; null = no border. Draw it straight off the row: a client never fetches a user's achievements to draw a border (TASK-6093)."
          },
          "address": {
            "type": "string",
            "description": "Canonical Solana wallet, else the canonical EVM wallet; \"\" for a walletless account (a group)"
          },
          "userId": {
            "type": "string",
            "description": "cc user-id UUID of the account — the follow key every /following route accepts; \"\" when cc served the row without one"
          },
          "user_id": {
            "type": "string",
            "description": "Deprecated alias of userId, served for shipped clients (docs/route-deprecations.md); read userId"
          },
          "kind": {
            "enum": [
              "person",
              "group"
            ]
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Always null: cc profiles carry no edge time"
          },
          "followers": {
            "type": "number"
          }
        },
        "required": [
          "username",
          "profile_image",
          "resolved_avatar_decoration",
          "address",
          "userId",
          "user_id",
          "kind",
          "timestamp",
          "followers"
        ]
      }
    }
  },
