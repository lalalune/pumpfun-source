{
  "name": "pump-app-reconstruction",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @pump-fun/pump-sdk build && pnpm --filter @pump-reconstruction/backend build && pnpm --filter @pump-reconstruction/frontend build",
    "dev": "pnpm --parallel --filter @pump-reconstruction/backend --filter @pump-reconstruction/frontend dev",
    "test": "pnpm --filter @pump-reconstruction/backend test && node --test tests/*.test.mjs && pnpm test:explore && pnpm test:feed && pnpm test:profile && pnpm test:mayhem && pnpm test:live && pnpm test:go && pnpm test:references && pnpm test:portfolio && python3 -m unittest discover -s tests -p \"test_capture*.py\" && python3 -m unittest discover -s tests -p \"test_verify_evidence.py\" && pnpm test:settings && pnpm test:notifications && pnpm test:public-wallet",
    "test:public-wallet": "node scripts/original-contracts/public-wallet/verify.mjs --check && node --experimental-strip-types --test tests/public_wallet.test.ts",
    "test:explore": "node --experimental-strip-types --test tests/explore_snapshot.test.ts",
    "test:feed": "node --experimental-strip-types --test tests/home_feed.test.ts tests/native_home_feed.test.ts",
    "test:profile": "pnpm --filter @pump-reconstruction/backend exec tsx --test ../../tests/profile_data.test.ts ../../tests/profile_follow_graph.test.ts ../../tests/local_user_search.test.ts",
    "test:mayhem": "node --experimental-strip-types --test tests/mayhem_screener.test.ts",
    "test:live": "node --experimental-strip-types --test tests/live_snapshot.test.ts",
    "test:go": "node --experimental-strip-types --test tests/go_bounties.test.ts",
    "test:references": "python3 scripts/extract-reference-pages.py --check && python3 -m unittest discover -s tests -p test_reference_pages.py && node --experimental-strip-types --test tests/reference_pages.test.ts",
    "test:settings": "node --experimental-strip-types --test tests/settings_model.test.ts",
    "test:portfolio": "pnpm --filter @pump-reconstruction/backend exec tsx --test ../../tests/portfolio_rpc.test.ts",
    "posttest": "pnpm --filter @pump-reconstruction/frontend test:browser && pnpm --filter @pump-reconstruction/frontend test:browser:native-feed",
    "typecheck": "pnpm -r typecheck",
    "capture": "python3 scripts/capture.py",
    "inventory": "node scripts/inventory.mjs",
    "graph:build": "node scripts/factory-graph/cli.mjs build",
    "graph:verify": "node scripts/factory-graph/cli.mjs verify",
    "graph:summary": "node scripts/factory-graph/cli.mjs summary",
    "graph:route": "node scripts/factory-graph/cli.mjs route",
    "graph:module": "node scripts/factory-graph/cli.mjs module",
    "graph:operations": "node scripts/factory-graph/cli.mjs operations",
    "test:graph": "node --test tests/factory_graph.test.mjs",
    "recover": "node scripts/format-bundles.mjs",
    "contracts": "openapi-typescript contracts/developer.openapi.json -o packages/backend/src/generated/developer-api.d.ts",
    "verify:evidence": "python3 scripts/verify-evidence.py",
    "smoke": "node scripts/smoke.mjs",
    "progress": "python3 scripts/progress.py",
    "check:progress": "python3 scripts/progress.py --check && python3 -m unittest discover -s tests -p \"test_progress.py\"",
    "test:notifications": "pnpm --filter @pump-reconstruction/backend exec node --import tsx --test ../../tests/notification_state.test.ts"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "@types/node": "22.18.6",
    "openapi-typescript": "7.10.1",
    "@babel/parser": "7.29.0",
    "@babel/generator": "7.29.0"
  }
}
