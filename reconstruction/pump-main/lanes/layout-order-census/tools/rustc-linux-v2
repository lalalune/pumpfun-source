#!/bin/bash
# experiment-only: speed-lane rustc shim v2 (3f4056d2d) adapted: Linux host in -vV and host --print=cfg; host cpufeatures gets libc.
REAL=$HOME/.cache/pumpfun-reconstruction/toolchains/hybrid144/rust/bin/rustc; HD="$(cd "$(dirname "$0")" && pwd)/hostdeps"
if [ "$#" -eq 1 ] && [ "$1" = "-vV" ]; then
  out="$("$REAL" -vV)" || exit $?
  printf '%s\n' "$out" | sed 's/^host: .*/host: x86_64-unknown-linux-gnu/'; exit 0
fi
probe=0; target=0; cpuf=0; prev=
for a in "$@"; do
  case "$a" in
    --print=cfg) probe=$((probe|1));;
    ___) probe=$((probe|2));;
    --target|--target=*) target=1;;
    cpufeatures) [ "$prev" = "--crate-name" ] && cpuf=1;;
  esac
  prev="$a"
done
if [ $probe -eq 3 ] && [ $target -eq 0 ]; then
  out="$("$REAL" "$@")" || exit $?
  cfg="$("$REAL" - --crate-name ___ --print=cfg --target x86_64-unknown-linux-gnu < /dev/null)" || exit $?
  printf '%s\n' "$out" | sed -n '1,/^___$/p'; printf '%s\n' "$cfg"; exit 0
fi
if [ $cpuf -eq 1 ] && [ $target -eq 0 ]; then
  exec "$REAL" "$@" --extern libc="$(ls "$HD"/liblibc-*.rlib | head -1)" -L dependency="$HD"
fi
if [ $target -eq 0 ]; then exec "$REAL" "$@" -L dependency="$HD"; fi
exec "$REAL" "$@"
