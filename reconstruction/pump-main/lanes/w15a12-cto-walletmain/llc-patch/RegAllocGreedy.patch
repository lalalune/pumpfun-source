+// ---- RAPRIO experiment hooks (private llc; never part of any build recipe) ----
+#include "llvm/Support/FileSystem.h"
+#include <cstdlib>
+#include <map>
+#include <set>
+#include <string>
+namespace {
+struct RaprioCfg {
+  bool Loaded = false;
+  std::map<unsigned, unsigned> Prio;   // vreg index -> absolute queue priority
+  std::map<unsigned, long> PrioAdd;    // vreg index -> priority delta
+  std::map<unsigned, std::string> ForceS, HintS; // vreg index -> "r9" / "spill"
+  std::map<unsigned, unsigned> Force, Hint;      // resolved phys (0 = spill)
+  std::set<unsigned> ForceDone;
+  llvm::raw_fd_ostream *Log = nullptr;
+  unsigned Seq = 0;
+  unsigned FirstNew = ~0u;
+};
+RaprioCfg RP;
+void rpParse(const char *E, std::map<unsigned, std::string> &M) {
+  if (!E) return;
+  std::string S(E); size_t i = 0;
+  while (i < S.size()) {
+    size_t j = S.find(',', i); if (j == std::string::npos) j = S.size();
+    std::string T = S.substr(i, j - i); size_t q = T.find('=');
+    if (q != std::string::npos) {
+      std::string K = T.substr(0, q); if (!K.empty() && K[0] == '%') K = K.substr(1);
+      M[(unsigned)std::stoul(K)] = T.substr(q + 1);
+    }
+    i = j + 1;
+  }
+}
+void rpLoad() {
+  if (RP.Loaded) return; RP.Loaded = true;
+  std::map<unsigned, std::string> P; rpParse(getenv("RAPRIO_PRIO"), P);
+  for (auto &KV : P) {
+    const std::string &V = KV.second;
+    if (!V.empty() && (V[0] == '+' || V[0] == '-')) RP.PrioAdd[KV.first] = std::stol(V, nullptr, 0);
+    else RP.Prio[KV.first] = (unsigned)std::stoul(V, nullptr, 0);
+  }
+  rpParse(getenv("RAPRIO_FORCE"), RP.ForceS);
+  rpParse(getenv("RAPRIO_HINT"), RP.HintS);
+  if (const char *L = getenv("RAPRIO_LOG")) {
+    std::error_code EC;
+    RP.Log = new llvm::raw_fd_ostream(L, EC, llvm::sys::fs::OF_Append);
+    if (EC) { delete RP.Log; RP.Log = nullptr; }
+  }
+}
+unsigned rpPhys(const llvm::TargetRegisterInfo *TRI, const std::string &N) {
+  if (N == "spill") return 0;
+  for (unsigned R = 1; R < TRI->getNumRegs(); ++R) {
+    std::string A = TRI->getName(R);
+    if (A.size() == N.size() && std::equal(A.begin(), A.end(), N.begin(), [](char x, char y) { return tolower(x) == tolower(y); }))
+      return R;
+  }
+  return ~0u;
+}
+} // namespace
+namespace llvm {
+std::map<const MachineInstr *, std::pair<unsigned, std::string>> RaprioTags;
+const char *raprioTag(const MachineInstr *MI) {
+  auto It = RaprioTags.find(MI);
+  if (It == RaprioTags.end() || It->second.first != MI->getOpcode()) return nullptr;
+  return It->second.second.c_str();
+}
+} // namespace llvm
+// ---- end RAPRIO ----
 
